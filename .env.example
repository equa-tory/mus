# Copy to .env (git-ignored) and restart the server.
# Leave PASSWORD empty or delete the line for no login: everyone can do everything.
# With a password set, only people who enter it can change anything (likes, playlists,
# scan, output/remote control). Everyone else is a listener: they can play any song
# locally or listen along with whatever you are playing, but nothing is saved.
PASSWORD=

# Set to true (needs PASSWORD) to hide everything behind a login page: nobody sees the library,
# plays music or reaches the API until they enter the password. Unset/false = guests can
# browse and listen as described above.
# REQUIRE_LOGIN=true

# Set to true (needs PASSWORD) to make everyone without the password a listen-along-only visitor:
# they hear exactly what you play and can't pick songs, skip, seek or play locally. Unset/false =
# guests can also play any song themselves (the default described above).
# LISTEN_ONLY=true

# Automatic database backups (library index, likes, playlists, history; art is rebuilt by a scan).
# Defaults shown. BACKUP_DIR= (empty) disables; BACKUP_EVERY_HOURS=0 = manual only.
# BACKUP_DIR=/mnt/backup/mus
# BACKUP_EVERY_HOURS=48
# BACKUP_KEEP=1

# Folder the YouTube music downloader (⚙ → Download music) saves songs into. A flat folder of .m4a
# files, deliberately NOT the music folder: mus doesn't scan it, you move what you like into your
# music folder yourself. Default shown.
# DOWNLOAD_DIR=/mnt/videos/Loop
