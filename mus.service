# Template — install.sh fills in the @PLACEHOLDERS@ and installs this as /etc/systemd/system/mus.service
[Unit]
Description=Local music streaming
After=network.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@DIR@

Environment="MUSIC_DIR=@MUSIC_DIR@"
Environment="DATA_DIR=@DIR@/data"
Environment=PYTHONUNBUFFERED=1

# Browsers keep /api/sync/events (an endless SSE stream) open, and uvicorn waits for every open
# connection on shutdown - forever by default, so systemd had to SIGKILL it after 90 s.
# Give open connections 3 s, then drop them; TimeoutStopSec is only a backstop.
ExecStart="@DIR@/venv/bin/uvicorn" app:app --host 0.0.0.0 --port @PORT@ --timeout-graceful-shutdown 3
TimeoutStopSec=15

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
