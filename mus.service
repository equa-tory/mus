# Template — install.sh fills in the @PLACEHOLDERS@ and installs this as /etc/systemd/system/mus.service
[Unit]
Description=Local music streaming
After=network.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@DIR@

Environment="MUSIC_DIR=@MUSIC_DIR@"
Environment="DATA_DIR=@DIR@/data"
Environment=PYTHONUNBUFFERED=1

ExecStart="@DIR@/venv/bin/uvicorn" app:app --host 0.0.0.0 --port @PORT@

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
